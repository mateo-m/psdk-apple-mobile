+// GLSL accepts only comments and blank lines before "#version", and a strict
+// compiler (Apple's OpenGL) rejects the shader when the injected header comes
+// first. The directive moves out here and goes back on top after the header.
+const std::regex kReVersionLine(R"(^[ \t]*#version[^\n]*\n?)", std::regex::multiline);
+
+std::string takeVersionLine(std::string& source) {
+	std::smatch m;
+	if (!std::regex_search(source, m, kReVersionLine)) {
+		return {};
+	}
+	std::string line = m.str();
+	if (line.empty() || line.back() != '\n') {
+		line.push_back('\n');
+	}
+	source.erase(static_cast<std::size_t>(m.position()), static_cast<std::size_t>(m.length()));
+	return line;
+}
