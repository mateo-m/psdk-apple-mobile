+void cgss::SpriteMap::setTileOpacity(std::size_t index, sf::Uint8 opacity) {
+	if (index >= m_proxy->m_sprites.size()) {
+		return;
+	}
+	m_proxy->m_sprites[index].sprite.setColor(sf::Color(255, 255, 255, opacity));
+}
+
+sf::Uint8 cgss::SpriteMap::getTileOpacity(std::size_t index) const {
+	if (index >= m_proxy->m_sprites.size()) {
+		return 255;
+	}
+	return m_proxy->m_sprites[index].sprite.getColor().a;
+}
